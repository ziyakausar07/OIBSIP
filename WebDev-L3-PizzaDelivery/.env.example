# -------------------------------------------------------------
# SliceCraft Pizza Delivery — Environment Configuration Template
# -------------------------------------------------------------

# Server Configuration
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/pizza_delivery_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_slicecraft_production_secure_random
JWT_EXPIRE=7d

# Razorpay Test Mode Credentials
# Obtain free test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Email Notification Credentials (Ethereal / Gmail / SendGrid)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="SliceCraft Pizza <orders@slicecraftpizza.com>"
ADMIN_EMAIL=admin@slicecraftpizza.com

# Cron Job Configurations (Default: every 15 minutes)
LOW_STOCK_CRON_SCHEDULE=*/15 * * * *
LOW_STOCK_COOLDOWN_HOURS=6
